{
  "name": "@this-project/akb",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.17.1",
  "type": "module",
  "engines": {
    "node": "26.12.1"
  },
  "scripts": {
    "format:check": "biome format . --diagnostic-level=error",
    "lint": "biome lint .",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('node:fs').rmSync('build',{recursive:true,force:true})\"",
    "test:unit": "pnpm run build && node script/test-suites.mjs unit",
    "test:integration": "pnpm run build && node script/test-suites.mjs integration",
    "test:browser": "playwright test --config playwright.config.ts",
    "test:agent": "node --test test/part-*.test.ts",
    "test:features": "node script/test-suites.mjs features",
    "test:features:postgres": "node script/test-suites.mjs features-postgres",
    "agent": "node app/agent-runtime.mjs",
    "test:postgres": "pnpm run build && node script/test-suites.mjs postgres",
    "test:r4": "pnpm run build && node --test build/test/r4-contracts.test.js build/test/r4-command-payloads.test.js && node script/test-suites.mjs r4",
    "test:commands": "pnpm run build && node --test build/test/r4-command-payloads.test.js && node script/test-suites.mjs commands",
    "test:backup": "pnpm run build && node script/test-suites.mjs backup",
    "test": "pnpm run test:unit && pnpm run test:integration && pnpm run test:agent && pnpm run test:features",
    "package:build": "pnpm --filter @slop-lab/akb-project-kb run build",
    "package:test": "pnpm run package:build && node script/test-project-kb-package.mjs",
    "build": "pnpm run package:build && pnpm run clean && tsc",
    "web:typecheck": "pnpm run package:build && tsc -p tsconfig.web.json",
    "web:test": "vitest run --config apps/web/vite.config.ts",
    "web:build": "pnpm run package:build && vite build --config apps/web/vite.config.ts",
    "web:dev": "vite --config apps/web/vite.config.ts",
    "setup:blocks": "node script/setup-blocks.mjs",
    "build:r4": "pnpm run build && pnpm run web:build",
    "check": "qg check --full",
    "check:code": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "quality:rules": "qg check --full --rules-only",
    "migrate:postgres": "node app/migrate-postgres.mjs",
    "start": "node app/server.mjs",
    "start:postgres": "node app/postgres-server.mjs",
    "start:r4": "node app/r4-server.mjs",
    "admin": "node app/admin.mjs",
    "outbox": "node app/outbox.mjs",
    "retention": "node app/retention.mjs",
    "backup": "node app/backup.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "1.56.1",
    "@slop-lab/qg": "0.1.0",
    "@slop-lab/qg-rules-js": "0.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "react-doctor": "^0.9.17",
    "react-grab": "^0.2.0",
    "react-scan": "^0.5.7",
    "typescript": "^5.9.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@slop-lab/akb-project-kb": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@slop-lab/part": "0.1.0",
    "@slop-lab/part-node": "0.1.0",
    "@slop-lab/part-plugins": "0.1.0",
    "ky": "^2.2.0",
    "postgres": "3.4.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "zod": "4.6.7"
  }
}
