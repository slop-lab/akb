{
  "name": "@slop-lab/akb-project-kb",
  "version": "0.1.0",
  "description": "Project notebooks, creative templates, and an embeddable knowledge library for AKB",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    "./contracts": {
      "types": "./dist/contracts.d.ts",
      "import": "./dist/contracts.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "import": "./dist/react/index.js"
    },
    "./styles.css": "./dist/react/styles.css"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-styles.mjs",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "ky": "^2.2.0",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "react": ">=19 <20",
    "react-dom": ">=19 <20"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.22.0"
  }
}
